# Copia este archivo como .env y ajusta los valores.
NODE_ENV=development
# En el servidor (detrás de Apache) usa HOST=127.0.0.1
HOST=0.0.0.0
PORT=3000
DATABASE_URL="postgresql://autocontrol:CAMBIAR@localhost:5432/autocontrol?schema=public"
# Base separada que usan los tests (se borra y recrea en cada corrida)
DATABASE_URL_TEST="postgresql://autocontrol:CAMBIAR@localhost:5432/autocontrol_test?schema=public"
# Cadena aleatoria de 32+ caracteres: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=7d
# true cuando el sitio funciona con HTTPS (servidor de prueba y producción)
COOKIE_SECURE=false
# true en desarrollo: Express sirve también la carpeta frontend/. En el servidor lo hace Apache.
SERVE_FRONTEND=true
MAX_UPLOAD_MB=5
