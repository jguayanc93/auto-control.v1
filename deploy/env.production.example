# backend/.env del SERVIDOR (copiar este archivo como backend/.env y completar).
# Nunca se sube a GitHub.

NODE_ENV=production

# Solo escucha dentro del servidor: Apache es quien recibe a los usuarios.
HOST=127.0.0.1
# Puerto interno (debe coincidir con deploy/apache/autocontrol.conf). Verifica que esté libre: ss -ltn | grep 3005
PORT=3005

# Contraseña: la que pusiste al crear el usuario de PostgreSQL
DATABASE_URL=postgresql://autocontrol:CAMBIAR@localhost:5432/autocontrol?schema=public

# Clave para firmar las sesiones. Genérala con:  openssl rand -hex 48
JWT_SECRET=CAMBIAR
JWT_EXPIRES_IN=7d

# true = la cookie de sesión solo viaja por HTTPS (obligatorio en el servidor)
COOKIE_SECURE=true
# Apache sirve el frontend; Node solo la API
SERVE_FRONTEND=false

MAX_UPLOAD_MB=5
